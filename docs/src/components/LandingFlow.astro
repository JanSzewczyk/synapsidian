---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const t = { day: "During the day, in any session", runs: "Scheduled runs", writes: "writes" };

const steps = [
  { cmd: "capture", show: ">> text", label: "Capture", note: "A prompt that starts with >> goes to the Inbox, no Claude turn", writes: "Inbox/" },
  { cmd: "save", label: "Save", note: "Files what matters from the conversation into notes and tasks", writes: "Notes/, Tasks/" },
  { cmd: "task", label: "Tasks", note: "Add, update, close or list numbered tasks", writes: "Tasks/" },
  { cmd: "find", label: "Find", note: "Search the vault and answer with links", writes: "nothing" },
  { cmd: "morning", label: "Morning", note: "Brief, agenda and meeting notes for the day", writes: "Daily/" },
  { cmd: "evening", label: "Evening", note: "Devlog from the day's sessions; decisions and how-tos filed", writes: "Daily/, notes" },
  { cmd: "review", label: "Review", note: "Weekly, monthly or quarterly review and a health pass", writes: "Reviews/" },
].map((s) => ({ ...s, show: s.show ?? `/synapsidian:${s.cmd}` }));

const groups = [
  { title: t.day, items: steps.slice(0, 4), offset: 0 },
  { title: t.runs, items: steps.slice(4), offset: 4 },
];
---

<div class="flow">
  {
    groups.map((g) => (
      <section class="group">
        <h3 class="group-title">{g.title}</h3>
        <ol start={g.offset + 1}>
          {g.items.map((s, i) => (
            <li>
              <a href={`${base}/skills/${s.cmd}/`}>
                <span class="node" aria-hidden="true">{g.offset + i + 1}</span>
                <span class="title">
                  <span class="label">{s.label}</span>
                  <code>{s.show}</code>
                </span>
                <span class="note">{s.note}</span>
                <span class="writes">
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                    <path d="M4 1.75h5l3 3v9.5H4zM9 1.75v3h3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  </svg>
                  <span class="sr-only">{t.writes} </span>{s.writes}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  /* Starlight prose adds margin-top between siblings; the component spaces itself */
  .flow :is(section, h3, ol, li, span, code, svg) {
    margin-top: 0 !important;
  }
  .flow {
    display: grid;
    gap: 1.75rem;
    margin: 1.75rem 0 0;
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 0.5rem;
    font-family: var(--sl-font);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .group-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--sl-color-hairline-shade);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    position: relative;
    margin: 0;
    padding: 0;
  }
  /* connector running through the nodes */
  li::before {
    content: "";
    position: absolute;
    left: calc(0.75rem + 1.125rem - 1px);
    top: 0;
    bottom: 0;
    width: 2px;
    background: color-mix(in srgb, var(--sl-color-accent) 30%, var(--sl-color-gray-5));
  }
  li:first-child::before {
    top: 1.925rem;
  }
  li:last-child::before {
    display: none;
  }
  li:only-child::before {
    display: none;
  }

  a {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    grid-template-areas:
      "node title"
      ". note"
      ". writes";
    column-gap: 1rem;
    row-gap: 0.25rem;
    align-items: center;
    padding: 0.8rem 0.75rem;
    border-radius: 0.625rem;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: background-color 0.15s;
  }
  a:hover,
  a:focus-visible {
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .node {
    grid-area: node;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--sl-color-accent-low);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    box-shadow: 0 0 0 4px var(--sl-color-black);
    color: var(--sl-color-accent-high);
    font-weight: 700;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  a:hover .node,
  a:focus-visible .node {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
  }

  .title {
    grid-area: title;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.75rem;
    min-width: 0;
  }
  .label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .flow .title code {
    background: none;
    border: 0;
    padding: 0;
    color: var(--sl-color-text-accent);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .note {
    grid-area: note;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .writes {
    grid-area: writes;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 999px;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .writes svg {
    flex: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  a:hover .writes,
  a:focus-visible .writes {
    border-color: color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
    color: var(--sl-color-text-accent);
  }
  .writes {
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  a:active .node {
    scale: 0.94;
  }
  .node {
    transition:
      background-color 0.15s,
      color 0.15s,
      scale 0.15s;
  }

  /* One row per phase: node, name and command, what it does, file it writes */
  @media (min-width: 44rem) {
    a {
      grid-template-columns: 2.25rem 15rem minmax(0, 1fr) 8.5rem;
      grid-template-areas: "node title note writes";
      column-gap: 1.25rem;
    }
    li:first-child::before {
      top: 50%;
    }
    li:last-child::before {
      display: block;
      bottom: 50%;
    }
    li:only-child::before {
      display: none;
    }
    .title {
      flex-direction: column;
      gap: 0.1rem;
    }
    .writes {
      justify-self: end;
    }
  }
</style>
