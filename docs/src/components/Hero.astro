---
import { LinkButton } from "@astrojs/starlight/components";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const t = {
  trail: "Example: one day of commits in a synapsidian vault",
  install: "Install in Claude Code",
  copy: "Copy",
  copied: "Copied",
  copyLabel: "Copy install commands",
};

interface Note {
  path: string;
  change: "A" | "M";
  meta?: string;
  body: string;
}
interface Commit {
  skill: string;
  msg: string;
  sha: string;
  when: string;
  notes?: Note[];
}
// Newest first, as git log prints it. Example content: neutral names, no real vault.
const commits: Commit[] = [
  {
    skill: "save",
    msg: "decision on export format",
    sha: "a41c2e9",
    when: "17:42",
    notes: [
      {
        path: "Decisions/2026-11-25 Export as CSV.md",
        change: "A",
        meta: "type: decision · status: accepted",
        body: 'Ship CSV first; add JSON once <span class="lk">[[Alex]]</span> confirms the format.',
      },
      {
        path: "Daily/2026-11-25.md",
        change: "M",
        body: '- Agreed the export format with <span class="lk">[[Alex]]</span> → <span class="lk">[[2026-11-25 Export as CSV]]</span>',
      },
    ],
  },
  { skill: "task", msg: "add T7 Renew the domain", sha: "9be0713", when: "14:05" },
  { skill: "capture", msg: "ask Alex about the export format", sha: "3f0d88b", when: "11:20" },
  { skill: "morning", msg: "brief 2026-11-25", sha: "c72a10e", when: "07:30" },
  { skill: "evening", msg: "devlog 2026-11-24", sha: "e5b9134", when: "yesterday" },
];
const last = commits.length - 1;

const installCmd = "/plugin marketplace add JanSzewczyk/synapsidian\n/plugin install synapsidian@synapsidian";
---

<div class="hero">
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
    <div class="install">
      <span class="install-label">{t.install}</span>
      <div class="install-box">
        <pre><code>{installCmd}</code></pre>
        <button type="button" class="copy-btn" data-text={installCmd} data-copied={t.copied} aria-label={t.copyLabel}>{t.copy}</button>
      </div>
    </div>
  </div>

  <figure class="trail" aria-label={t.trail}>
    <figcaption class="trail-head">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5.6A2.7 2.7 0 0 0 7.4 4.9 2.7 2.7 0 0 0 4.3 8.6 2.8 2.8 0 0 0 3.6 13.4 2.7 2.7 0 0 0 6.2 17.6 2.7 2.7 0 0 0 10.4 19 2.2 2.2 0 0 0 12 18.2 2.2 2.2 0 0 0 13.6 19 2.7 2.7 0 0 0 17.8 17.6 2.7 2.7 0 0 0 20.4 13.4 2.8 2.8 0 0 0 19.7 8.6 2.7 2.7 0 0 0 16.6 4.9 2.7 2.7 0 0 0 12 5.6Z" />
          <path d="M12 5.6V18.2M7.6 8.2C8.8 8 9.6 8.9 9.4 10M5.8 11.6C7.4 11.2 8.6 12 8.6 13.4M8 16C9.2 15.6 10 16.2 10 17.1M16.4 8.2C15.2 8 14.4 8.9 14.6 10M18.2 11.6C16.6 11.2 15.4 12 15.4 13.4M16 16C14.8 15.6 14 16.2 14 17.1" />
        </g>
      </svg>
      <span>git log</span>
      <span class="head-note">example vault · one commit per run</span>
    </figcaption>
    <ol class="commits">
      {
        commits.map((c, i) => (
          <li class:list={["commit", { open: c.notes }]} style={`--i:${last - i}`}>
            <span class="dot" aria-hidden="true" />
            <p class="msg">
              <b>synapsidian({c.skill})</b>: {c.msg}
            </p>
            <p class="meta">
              <span>{c.sha}</span>
              <span>{c.when}</span>
            </p>
            {c.notes && (
              <ul class="notes">
                {c.notes.map((n) => (
                  <li class="note">
                    <p class="path">
                      <span>{n.path}</span>
                      <span class="change">{n.change === "A" ? "new" : "edited"}</span>
                    </p>
                    {n.meta && <p class="fm">{n.meta}</p>}
                    <p class="body" set:html={n.body} />
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </figure>
</div>

<script is:inline>
  /* Section reveal is opt-in: hidden states exist only once this flag is set */
  if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("reveal-ready");
    setTimeout(() => {
      if (!document.documentElement.dataset.revealLive) document.documentElement.classList.remove("reveal-ready");
    }, 3000);
  }
</script>

<script>
  const targets = [
    ".landing-section > .sl-heading-wrapper",
    ".landing-section > .landing-lead",
    ".flow .group-title",
    ".flow li",
    ".plugins .group-title",
    ".plugins li",
    ".why-intro",
    ".why > div",
    ".start-copy",
    ".start-code",
    ".explore a",
  ].join(",");
  const els = Array.from(document.querySelectorAll<HTMLElement>(targets));
  const root = document.documentElement;
  if (root.classList.contains("reveal-ready") && els.length) {
    root.dataset.revealLive = "1";
    let initial = true;
    const io = new IntersectionObserver(
      (entries) => {
        const batch = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top || a.boundingClientRect.left - b.boundingClientRect.left);
        batch.forEach((e, i) => {
          // first batch waits for the hero to settle
          (e.target as HTMLElement).style.setProperty("--rd", `${(initial ? 0.5 : 0) + Math.min(i, 9) * 0.06}s`);
          e.target.classList.add("in");
          io.unobserve(e.target);
        });
        initial = false;
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.05 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<script>
  document.querySelectorAll<HTMLButtonElement>(".hero .copy-btn").forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.text ?? "");
        btn.textContent = btn.dataset.copied ?? "";
        btn.dataset.state = "done";
        setTimeout(() => {
          btn.textContent = label;
          delete btn.dataset.state;
        }, 1800);
      } catch {
        /* clipboard blocked: the text stays selectable */
      }
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(1.5rem, 4vw, 3rem) 1rem;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      gap: 3.5rem;
      padding-block: clamp(2.5rem, 7vh, 5rem) 2rem;
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    min-width: 0;
  }
  h1 {
    margin: 0;
    max-width: 19ch;
  }
  .tagline {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 0.25rem;
  }

  /* Install */
  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    width: 100%;
    max-width: 34rem;
    margin-top: 0.75rem;
  }
  .install-label {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-3);
  }
  .install-box {
    position: relative;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7);
  }
  .install-box pre {
    margin: 0;
    padding: 0.8rem 5.25rem 0.8rem 1rem;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.7;
    background: none;
    border: 0;
  }
  /* Narrow screens: the commands are wider than the box, so the button moves up beside the
     label instead of covering the scrolled text */
  @media (max-width: 40rem) {
    .install-label {
      min-height: 2rem;
      display: flex;
      align-items: center;
    }
    .install-box pre {
      padding-right: 1rem;
    }
    .install-box .copy-btn {
      top: calc(-2rem - 0.4rem);
      right: 0;
    }
  }
  .install-box code {
    background: none;
    border: 0;
    padding: 0;
    color: var(--sl-color-gray-1);
  }
  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    min-height: 2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .copy-btn:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }
  .copy-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .copy-btn[data-state="done"] {
    border-color: var(--sl-color-green);
    color: var(--sl-color-green-high);
  }

  /* Trail: the vault's git log, newest first. Each run is one commit named after its skill;
     the newest save is open onto the notes it wrote. Follows the site theme. */
  .trail {
    --rail: var(--sl-color-hairline);
    --dot: var(--sl-color-gray-5);
    --clay: var(--sl-color-accent);
    --link: var(--sl-color-text-accent);
    margin: 0;
    min-width: 0;
    font-family: var(--sl-font-mono);
  }
  /* In light the rail and hollow dots need about 3:1 against white to read */
  :root[data-theme="light"] .trail {
    --rail: #a3a3a3;
    --dot: #a3a3a3;
  }
  .trail-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-size: 0.78rem;
    color: var(--sl-color-gray-2);
  }
  .trail-head svg {
    color: var(--clay);
  }
  .head-note {
    margin-inline-start: auto;
    color: var(--sl-color-gray-3);
  }
  .commits {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* the rail */
  .commits::before {
    content: "";
    position: absolute;
    inset-block: 1.35rem 1.35rem;
    inset-inline-start: 0.4rem;
    width: 2px;
    border-radius: 1px;
    background: var(--rail);
  }
  .commit {
    position: relative;
    margin: 0;
    padding: 0.75rem 0 0.75rem 1.9rem;
  }
  .commit + .commit {
    margin: 0;
  }
  .dot {
    position: absolute;
    inset-inline-start: 0;
    top: 1.05rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 2px solid var(--dot);
    background: var(--sl-color-black);
  }
  .open .dot {
    border-color: var(--clay);
    background: var(--clay);
  }
  .commit p {
    margin: 0;
  }
  .msg {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    overflow-wrap: anywhere;
  }
  .msg b {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .open .msg b {
    color: var(--link);
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-3);
  }
  .notes {
    list-style: none;
    margin: 0.8rem 0 0.15rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .note {
    margin: 0;
    padding: 0.75rem 0.9rem 0.8rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7);
    box-shadow: 0 14px 28px -22px rgb(0 0 0 / 0.55);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  :root[data-theme="light"] .note {
    background: #fff;
    box-shadow: 0 14px 28px -22px rgb(120 60 30 / 0.35);
  }
  .path {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 0.75rem;
    font-weight: 600;
    color: var(--link);
    overflow-wrap: anywhere;
  }
  .change {
    flex: none;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }
  .fm {
    margin-top: 0.2rem !important;
    color: var(--sl-color-gray-3);
  }
  .body {
    margin-top: 0.35rem !important;
    color: var(--sl-color-gray-2);
  }
  .body :global(.lk) {
    white-space: nowrap;
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--link) 40%, transparent);
    text-underline-offset: 0.18em;
  }

  /* Below the two-column width the copy's children join the hero grid, so the commit trail
     sits right after the actions and the install box follows it. */
  @media (max-width: 63.99rem) {
    .hero {
      gap: 1.25rem;
    }
    .copy {
      display: contents;
    }
    .trail {
      order: 1;
      margin-block: 0.75rem 0.25rem;
    }
    .install {
      order: 2;
    }
  }
  .copy-btn:active {
    transform: scale(0.97);
  }

  /* One authored moment: the copy settles, then the day's commits land oldest first up the rail,
     and the newest save opens onto the notes it wrote. Without motion, the end state shows. */
  @media (prefers-reduced-motion: no-preference) {
    .copy > * {
      animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--k, 0) * 0.07s);
    }
    .copy > :nth-child(2) {
      --k: 1;
    }
    .copy > :nth-child(3) {
      --k: 2;
    }
    .copy > :nth-child(4) {
      --k: 3;
    }
    .trail-head {
      animation: fade 0.5s ease-out 0.15s both;
    }
    .commits::before {
      transform-origin: bottom;
      animation: grow 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
    }
    .commit {
      --d: calc(0.4s + var(--i) * 0.16s);
    }
    .commit > .dot {
      animation: pop 0.4s cubic-bezier(0.16, 1, 0.3, 1) var(--d) both;
    }
    .commit > .msg,
    .commit > .meta {
      animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d) + 0.05s) both;
    }
    .open > .dot {
      animation:
        pop 0.4s cubic-bezier(0.16, 1, 0.3, 1) var(--d) both,
        ping 1.2s ease-out calc(var(--d) + 0.3s) 1 both;
    }
    .note {
      animation: open 0.7s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d) + 0.45s) both;
    }
    .note + .note {
      animation-delay: calc(var(--d) + 0.6s);
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }
    @keyframes fade {
      from {
        opacity: 0;
      }
    }
    @keyframes grow {
      from {
        transform: scaleY(0);
      }
    }
    @keyframes pop {
      from {
        opacity: 0;
        transform: scale(0.4);
      }
    }
    @keyframes ping {
      from {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--clay) 50%, transparent);
      }
      to {
        box-shadow: 0 0 0 10px transparent;
      }
    }
    @keyframes open {
      from {
        opacity: 0;
        clip-path: inset(0 0 100% 0 round 0.5rem);
        transform: translateY(-6px);
      }
      to {
        clip-path: inset(0 0 0 0 round 0.5rem);
      }
    }
  }
</style>
